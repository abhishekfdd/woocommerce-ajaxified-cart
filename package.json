{
    "name": "UserBlog",
    "private": true,
    "scripts": {
        "build": "webpack --mode=production",
        "watch": "webpack --watch --mode=development",
        "pot": "wp-pot --src '**/*.php' --domain 'abwc-ajax-cart' --package 'Ajaxified Cart for Online Stores' --dest 'languages/abwc-ajax-cart.pot'",
        "mo": "find languages -name '*.po' -exec sh -c 'for f; do msgfmt \"$f\" -o \"${f%.po}.mo\"; done' sh {} +",
        "lint": "eslint assets/js/abwc-ajax-cart.js assets/js/abwc-ajax-variation-cart.js assets/js/abwc-ajax-cart-admin.js"
    },
    "devDependencies": {
        "@babel/core": "^7.25.0",
        "@babel/preset-env": "^7.25.0",
        "babel-loader": "^9.1.3",
        "core-js": "^3.46.0",
        "webpack": "^5.94.0",
        "webpack-cli": "^5.1.4",
        "wp-pot": "^1.10.0",
        "eslint": "^9.11.0"
    },
    "browserslist": [
        "last 2 versions",
        ">0.5%",
        "not dead"
    ]
}
